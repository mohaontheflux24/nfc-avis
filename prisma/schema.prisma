// Schéma de la base de données (SQLite en local, changez "provider" pour "postgresql" en prod)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  businesses Business[]
}

model Business {
  id             String   @id @default(cuid())
  name           String
  googleReviewUrl String?
  logoUrl        String?
  createdAt      DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  cards   NfcCard[]
  reviews Review[]
}

model NfcCard {
  id        String   @id @default(cuid())
  label     String   // ex: "Table 1", "Comptoir", "Carte principale"
  code      String   @unique // code court utilisé dans l'URL /r/[code]
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  scans   Scan[]
  reviews Review[]
}

model Scan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  cardId String
  card   NfcCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 à 5
  comment   String?  // rempli seulement si note basse (1-3)
  redirected Boolean @default(false) // true si le client a été renvoyé vers Google
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  cardId String
  card   NfcCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}
